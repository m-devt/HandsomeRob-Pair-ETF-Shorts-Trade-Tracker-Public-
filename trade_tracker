SUPABASE_URL = os.environ.get("SUPABASE_URL")
SUPABASE_KEY = os.environ.get("SUPABASE_KEY")  # Use your sb_secret_ key here
BUCKET_NAME = "handsomerob-trade-tracker"
PORTFOLIO_FILE = "portfolio_trade_tracker.csv"

def get_supabase_client() -> Client:
    return create_client(SUPABASE_URL, SUPABASE_KEY)

def load_live_portfolio():
    """Securely downloads your private portfolio file from Supabase storage into memory."""
    supabase = get_supabase_client()
    
    # # Check if file exists locally first (e.g. during an interactive local run)
    # if os.path.exists(PORTFOLIO_FILE):
    #     return pd.read_csv(PORTFOLIO_FILE)
 
    try:
        send_alerts("📥 Downloading portfolio tracking state from Supabase Private Storage...")

        # print("SUPABASE_URL =", SUPABASE_URL)
        # print("BUCKET_NAME =", BUCKET_NAME)
        # print("FILE =", PORTFOLIO_FILE)

        with open(PORTFOLIO_FILE, "wb") as f:
            # DEBUG TO CHECK READING FILE
            # bucket = supabase.storage.from_(BUCKET_NAME)
            # print("Attempting download...")
            # res = bucket.download(PORTFOLIO_FILE)
            # print(type(res))
            # print(res)
            res = supabase.storage.from_(BUCKET_NAME).download(PORTFOLIO_FILE)
            f.write(res)
        return pd.read_csv(PORTFOLIO_FILE)
    except Exception as e:
        send_alerts(f"⚠️ Cloud file not found or connection failed: {e}")
        send_alerts("Starting interactive initialization wizard...")
        return None

def save_live_portfolio(df):
    """Saves the updated dataframe locally, uploads it to private cloud, then cleans up."""
    supabase = get_supabase_client()
    
    # 1. Save locally to temporary disk space
    df.to_csv(PORTFOLIO_FILE, index=False)
    
    # 2. Upload and overwrite the private file in your Supabase bucket
    try:
        with open(PORTFOLIO_FILE, "rb") as f:
            supabase.storage.from_(BUCKET_NAME).upload(
                path=PORTFOLIO_FILE, 
                file=f, 
                file_options={"cache-control": "3600", "upsert": "true"}
            )
        print("🔒 Portfolio securely synchronized and locked back in private cloud storage.")
    except Exception as e:
        send_alerts(f"❌ Failed to sync file to Supabase: {e}")
        
    # 3. Securely erase the local file if running inside a temporary GitHub runner environment
    # If you want to keep a permanent local backup copy, comment out the lines below
    # if os.path.exists(PORTFOLIO_FILE):
    #     os.remove(PORTFOLIO_FILE)

